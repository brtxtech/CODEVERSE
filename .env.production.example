# Use a trusted auth issuer. Do not put admin/service role credentials in the browser.
CODEVERSE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
CODEVERSE_JWT_AUDIENCE=authenticated
# DEVELOPMENT ONLY: persistent evidence ledger; not distributed-safe.
CODEVERSE_LEDGER_DB=./codeverse-local-ledger.sqlite
# GitHub credentials must be server side (not required by local static scanner).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET=
